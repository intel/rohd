{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Dependency Bundle: ROHD Core",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group rohd ${input:rohdSource} && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdGitRef}"
                }
            },
            "problemMatcher": [],
            "detail": "Local uses the Pub workspace package; hosted and Git select an external ROHD source."
        },
        {
            "label": "Configure Dependency Bundle: ROHD Packages",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group rohd-packages ${input:rohdPackageSource} && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdGitRef}"
                }
            },
            "problemMatcher": [],
            "detail": "Local uses the Pub workspace packages; hosted and Git select external package sources."
        },
        {
            "label": "Configure Dependency Bundle: Local ROHD Repository",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group rohd local && bash tool/devtools/devtools_dev_mode.sh configure-group rohd-packages local && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Resolve rohd and all in-repository companion packages from this Pub workspace."
        },
        {
            "label": "Configure Dependency Bundle: Wave Viewer",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group wave-viewer ${input:waveViewerSource} && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "WAVE_VIEWER_GIT_REF": "${input:waveViewerGitRef}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted or Git for rohd_wave_viewer and dart_wellen without changing the schematic viewer."
        },
        {
            "label": "Configure Dependency Bundle: Schematic Viewer",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group schematic-viewer ${input:schematicViewerSource} && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SCHEMATIC_VIEWER_GIT_REF": "${input:schematicViewerGitRef}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted or Git for rohd_schematic_viewer without changing the wave viewer."
        },
        {
            "label": "Configure Dependency Bundle: All",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh configure-group all ${input:allDependencySource} && flutter pub get --directory=rohd_devtools_extension",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdGitRef}",
                    "WAVE_VIEWER_GIT_REF": "${input:waveViewerGitRef}",
                    "SCHEMATIC_VIEWER_GIT_REF": "${input:schematicViewerGitRef}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted or Git for every ROHD and viewer dependency."
        },
        {
            "label": "Run: Web Debug (choose dependency bundles)",
            "type": "shell",
            "command": "bash rohd_devtools_extension/scripts/devtools_run.sh web-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Web Release (choose dependency bundles)",
            "type": "shell",
            "command": "bash rohd_devtools_extension/scripts/devtools_run.sh web-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Debug (choose dependency bundles)",
            "type": "shell",
            "command": "bash rohd_devtools_extension/scripts/devtools_run.sh linux-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Release (choose dependency bundles)",
            "type": "shell",
            "command": "bash rohd_devtools_extension/scripts/devtools_run.sh linux-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Show DevTools Dependency Sources",
            "type": "shell",
            "command": "bash tool/devtools/devtools_dev_mode.sh show",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "rohdSource",
            "type": "pickString",
            "description": "Source for rohd",
            "options": ["hosted", "git", "local"],
            "default": "local"
        },
        {
            "id": "rohdPackageSource",
            "type": "pickString",
            "description": "Source for the ROHD companion package bundle",
            "options": ["hosted", "git", "local"],
            "default": "local"
        },
        {
            "id": "waveViewerSource",
            "type": "pickString",
            "description": "Source for rohd_wave_viewer and dart_wellen",
            "options": ["hosted", "git"],
            "default": "hosted"
        },
        {
            "id": "schematicViewerSource",
            "type": "pickString",
            "description": "Source for rohd_schematic_viewer",
            "options": ["hosted", "git"],
            "default": "hosted"
        },
        {
            "id": "allDependencySource",
            "type": "pickString",
            "description": "Source for every ROHD and viewer dependency",
            "options": ["hosted", "git"],
            "default": "hosted"
        },
        {
            "id": "rohdGitRef",
            "type": "promptString",
            "description": "Git ref for ROHD packages",
            "default": "main"
        },
        {
            "id": "waveViewerGitRef",
            "type": "promptString",
            "description": "Git ref for Wave Viewer packages",
            "default": "main"
        },
        {
            "id": "schematicViewerGitRef",
            "type": "promptString",
            "description": "Git ref for Schematic Viewer packages",
            "default": "main"
        }
    ]
}
