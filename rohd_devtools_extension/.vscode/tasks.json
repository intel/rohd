{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Dependency Bundle: ROHD Core",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh configure-group rohd ${input:rohdSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for the fundamental rohd package."
        },
        {
            "label": "Configure Dependency Bundle: ROHD Packages",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh configure-group rohd-packages ${input:rohdPackageSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select one source for rohd_hierarchy, rohd_waveform, rohd_devtools_widgets, and rohd_source_navigator."
        },
        {
            "label": "Configure Dependency Bundle: Wave Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh configure-group wave-viewer ${input:waveViewerSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "WAVE_VIEWER_GIT_REF": "${input:waveViewerSourceValue}",
                    "WAVE_VIEWER_LOCAL_PATH": "${input:waveViewerSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for rohd_wave_viewer and dart_wellen without changing the schematic viewer."
        },
        {
            "label": "Configure Dependency Bundle: Schematic Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh configure-group schematic-viewer ${input:schematicViewerSource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SCHEMATIC_VIEWER_GIT_REF": "${input:schematicViewerSourceValue}",
                    "SCHEMATIC_VIEWER_LOCAL_PATH": "${input:schematicViewerSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select hosted, Git, or local for rohd_schematic_viewer without changing the wave viewer."
        },
        {
            "label": "Configure Dependency Bundle: All",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh configure-group all ${input:allDependencySource} && flutter pub get",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ROHD_GIT_REF": "${input:rohdSourceValue}",
                    "ROHD_LOCAL_PATH": "${input:rohdSourceValue}",
                    "WAVE_VIEWER_GIT_REF": "${input:waveViewerSourceValue}",
                    "WAVE_VIEWER_LOCAL_PATH": "${input:waveViewerSourceValue}",
                    "SCHEMATIC_VIEWER_GIT_REF": "${input:schematicViewerSourceValue}",
                    "SCHEMATIC_VIEWER_LOCAL_PATH": "${input:schematicViewerSourceValue}"
                }
            },
            "problemMatcher": [],
            "detail": "Select one source for every ROHD and viewer dependency."
        },
        {
            "label": "Run: Web Debug (choose dependency bundles)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh web-debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Web Release (choose dependency bundles)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh web-release",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Debug (choose dependency bundles)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh linux-debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Release (choose dependency bundles)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh linux-release",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Show DevTools Dependency Sources",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh show",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "rohdSource",
            "type": "pickString",
            "description": "Source for rohd",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "rohdPackageSource",
            "type": "pickString",
            "description": "Source for the ROHD companion package bundle",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "waveViewerSource",
            "type": "pickString",
            "description": "Source for rohd_wave_viewer and dart_wellen",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "schematicViewerSource",
            "type": "pickString",
            "description": "Source for rohd_schematic_viewer",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "allDependencySource",
            "type": "pickString",
            "description": "Source for every ROHD and viewer dependency",
            "options": ["hosted", "git", "local"],
            "default": "hosted"
        },
        {
            "id": "rohdSourceValue",
            "type": "promptString",
            "description": "Git ref or local ROHD checkout path (leave blank for the default)",
            "default": ""
        },
        {
            "id": "waveViewerSourceValue",
            "type": "promptString",
            "description": "Git ref or local Wave Viewer checkout path (leave blank for the default)",
            "default": ""
        },
        {
            "id": "schematicViewerSourceValue",
            "type": "promptString",
            "description": "Git ref or local Schematic Viewer checkout path (leave blank for the default)",
            "default": ""
        }
    ]
}
