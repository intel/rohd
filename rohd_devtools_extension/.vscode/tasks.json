        {
            "label": "Set [HR LE LV] Hosted ROHD + Local Extension + Local Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh hr-le-lv && flutter pub get",
            "problemMatcher": []
        },
        {
            "label": "Set [LR LE LV] Local ROHD + Local Extension + Local Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh lr-le-lv && flutter pub get",
            "problemMatcher": []
        },
        {
            "label": "Run: Web Debug (choose dependency mode)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh \"${input:devtoolsDependencyMode}\" web-debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Web Release (choose dependency mode)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh \"${input:devtoolsDependencyMode}\" web-release",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "is being served at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Debug (choose dependency mode)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh \"${input:devtoolsDependencyMode}\" linux-debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Run: Linux Release (choose dependency mode)",
            "type": "shell",
            "command": "bash scripts/devtools_run.sh \"${input:devtoolsDependencyMode}\" linux-release",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^Application finished"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Show DevTools Dependency Mode",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh show",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "devtoolsDependencyMode",
            "type": "pickString",
            "description": "Choose dependency sources.",
            "default": "lr-le-lv (Local ROHD + Local DevTools Extension + Local Viewer)",
            "options": [
                "hr-he-hv (Hosted ROHD + Hosted DevTools Extension + Hosted Viewer)",
                "lr-he-hv (Local ROHD + Hosted DevTools Extension + Hosted Viewer)",
                "hr-le-hv (Hosted ROHD + Local DevTools Extension + Hosted Viewer)",
                "lr-le-hv (Local ROHD + Local DevTools Extension + Hosted Viewer)",
                "hr-he-lv (Hosted ROHD + Hosted DevTools Extension + Local Viewer)",
                "lr-he-lv (Local ROHD + Hosted DevTools Extension + Local Viewer)",
                "hr-le-lv (Hosted ROHD + Local DevTools Extension + Local Viewer)",
                "lr-le-lv (Local ROHD + Local DevTools Extension + Local Viewer)"
            ]
        }
    ]
}
