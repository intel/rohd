{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Set [HR HE HV] Hosted ROHD + Hosted Extension + Hosted Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh hr-he-hv && flutter pub get",
            "problemMatcher": []
        },
        {
            "label": "Set [LR HE HV] Local ROHD + Hosted Extension + Hosted Viewer",
            "type": "shell",
            "command": "bash scripts/devtools_dev_mode.sh lr-he-hv && flutter pub get",
            "problemMatcher": []
        },
        {
            "label": "Set [HR LE HV] Hosted ROHD + Local Extension + Hosted Viewer",
